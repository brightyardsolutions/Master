    "dev": "node tools/dev.mjs main",
    "dev:allocivo": "node tools/dev.mjs allocivo",
    "dev:xessly": "node tools/dev.mjs xessly",
    "build:functions": "node tools/build-functions.mjs",
    "test:compare": "node tests/compare.mjs",
