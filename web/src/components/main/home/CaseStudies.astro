import { link } from '../../../lib/links.mjs';
const site = import.meta.env.SITE_KEY;
---
<div class="sec alt" data-draft><div class="wrap">
<div class="head" style="display:flex;justify-content:space-between;align-items:end;flex-wrap:wrap;gap:20px;max-width:none"><div><span class="eyebrow rv">Case studies</span><h2 class="split">Proof, with the numbers attached.</h2></div><a class="btn out rv" href={link('work', site)}>View all work <span class="arrow">&rarr;</span></a></div>
<div class="g3">
<a class="card tilt case rv" href={link('work', site)}><div><span class="tag"><span class="tbd">[Service]</span></span><h3><span class="tbd">[Client type]</span> <span class="tbd">[what we built or changed]</span></h3><p><span class="tbd">[What was true before, in one sentence]</span></p></div><div class="num"><span class="tbd">[Metric]</span><small><span class="tbd">[unit and timeframe]</span></small></div><span class="go">&nearr;</span></a>
<a class="card tilt case rv" style="--d:100ms" href={link('work', site)}><div><span class="tag"><span class="tbd">[Service]</span></span><h3><span class="tbd">[Client type]</span> <span class="tbd">[what we built or changed]</span></h3><p><span class="tbd">[What was true before, in one sentence]</span></p></div><div class="num"><span class="tbd">[Metric]</span><small><span class="tbd">[unit and timeframe]</span></small></div><span class="go">&nearr;</span></a>
