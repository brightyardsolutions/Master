import { link } from '../../../lib/links.mjs';
const site = import.meta.env.SITE_KEY;
---
<div class="sec"><div class="wrap">
<div class="head"><span class="eyebrow rv">How we work</span><h2 class="split">Agents build every day. You see working software every two weeks.</h2></div>
<div class="story">
<div class="spanel" aria-hidden="true">
<div class="vs on" data-s="0"><svg viewBox="0 0 300 220"><g stroke="#4F46E5" stroke-width="2" fill="none" class="dr"><path d="M60 110 L130 50 L220 70 L240 150 L150 180 L60 110 M130 50 L150 180 M220 70 L60 110"/></g><g fill="#C6F432" stroke="#4F46E5" stroke-width="2"><circle cx="60" cy="110" r="12"/><circle cx="130" cy="50" r="12"/><circle cx="220" cy="70" r="12"/><circle cx="240" cy="150" r="12"/><circle cx="150" cy="180" r="12"/></g></svg></div>
<div class="vs" data-s="1"><svg viewBox="0 0 300 220"><rect x="30" y="30" width="240" height="160" rx="16" fill="#fff" stroke="#E4E0FB" stroke-width="2"/><g fill="#C6F432" stroke="#4F46E5" stroke-width="1.5"><rect class="pl" x="54" y="60" width="150" height="14" rx="7"/><rect class="pl" style="animation-delay:.3s" x="54" y="92" width="190" height="14" rx="7"/><rect class="pl" style="animation-delay:.6s" x="54" y="124" width="110" height="14" rx="7"/><rect class="pl" style="animation-delay:.9s" x="54" y="156" width="170" height="14" rx="7"/></g></svg></div>
<div class="vs" data-s="2"><svg viewBox="0 0 300 220"><rect x="30" y="86" width="240" height="48" rx="24" fill="#fff" stroke="#E4E0FB" stroke-width="2"/><rect class="pl" x="38" y="94" width="224" height="32" rx="16" fill="#C6F432" stroke="#4F46E5" stroke-width="2"/><text x="150" y="170" text-anchor="middle" font-size="16" font-weight="600" fill="#1E1B4B" font-family="Inter,sans-serif">Staged rollout</text></svg></div>
<div class="vs" data-s="3"><svg viewBox="0 0 300 220"><path class="ecg" d="M20 110 H90 L110 60 L135 160 L158 90 L172 110 H280" fill="none" stroke="#4F46E5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="150" cy="190" r="6" fill="#22C55E"/><text x="164" y="195" font-size="13" fill="#1E1B4B" font-family="Inter,sans-serif">All systems healthy</text></svg></div>
</div>
<div>
<div class="sstep on" data-s="0"><span class="n">01</span><h3>Discover</h3><p>Agents turn your brief, documents and existing systems into user stories and an architecture draft. Engineers sit with you to understand what really matters, and agree in writing what "done" looks like.</p></div>
<div class="sstep" data-s="1"><span class="n">02</span><h3>Build in slices</h3><p>Agents write the code, tests and documentation. Every two weeks you see working software, and an engineer has reviewed every change before you do.</p></div>
<div class="sstep" data-s="2"><span class="n">03</span><h3>Launch quietly</h3><p>Test, security and accessibility agents check every change, then roll it out in stages. The best launches are the ones nobody notices.</p></div>
<div class="sstep" data-s="3"><span class="n">04</span><h3>Run and improve</h3><p>Ops agents watch your system around the clock. Engineers study what they find and make the next version better.</p><a class="more" href={link('how', site)}>Read the full playbook <span class="arrow">&rarr;</span></a></div>
</div>
</div>
</div></div>
