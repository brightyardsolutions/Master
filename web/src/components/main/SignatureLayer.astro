---
// Yard menu dock (G), Blueprint mode (B), the lens and the yard menu dialog.
---
<div class="dock" id="dock">
  <button id="gbtn" type="button" aria-haspopup="dialog" aria-expanded="false" aria-label="Open yard menu">
    <span class="gico" aria-hidden="true"><i class="y"></i><i></i><i class="y"></i><i></i><i class="y"></i><i></i><i></i><i class="y"></i><i></i></span>
    <span class="lb">Yard menu</span><kbd>G</kbd>
  </button>
  <button id="bbtn" type="button" aria-pressed="false" aria-label="Toggle blueprint mode">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
    <span class="lb">Blueprint</span><kbd>B</kbd>
  </button>
</div>
<div class="bhint" id="bhint" role="status"></div>

<div id="bp" aria-hidden="true"><div id="bpann"></div></div>
<div id="bring" aria-hidden="true"><span id="bro"></span></div>

<div id="gl" role="dialog" aria-modal="true" aria-label="Yard menu" aria-hidden="true" data-lenis-prevent>
  <div class="glh">Yard menu<small>Four dots make the Y</small></div>
  <button class="glx" id="glx" type="button" aria-label="Close menu">&times;</button>
  <div class="gg" id="gg" role="menu"></div>
  <div class="glf">Press <kbd>1</kbd> to <kbd>9</kbd> to jump &middot; <kbd>Esc</kbd> to close &middot; <button type="button" class="glk" id="glk" aria-pressed="true">Single-key shortcuts: on</button></div>
</div>
