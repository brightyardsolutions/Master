---
// Live demo screens for Allocivo (tpl-al) and Xessly (tpl-xs), cloned by the script into [data-ui] slots.
---
<template id="tpl-al">
<div class="aui" data-state="0">
<div class="aui-h"><span>Northstar Hotel &middot; Room turns</span><span class="illus">Illustrative demo data</span></div>
<div class="aui-row"><b>512</b><span>Early arrival 12:30</span><em class="t-hi">Priority</em></div>
<div class="aui-row r418"><b>418</b><span>Clean &middot; ready by 14:00</span><em class="own"><i class="o1">Daniel</i><i class="o2">Asha</i></em><em class="t-risk">At risk</em><em class="t-ok">On track</em></div>
<div class="aui-row"><b>206</b><span>Maintenance blocker</span><em class="t-blk">Blocked</em></div>
<div class="aui-rec"><div><small>Recommendation R-07</small><b>Move Room 418 to Asha</b><span>Daniel is running 25 min late. Asha is free, qualified for room turns and already on floor 4.</span></div><span class="ap">Approve</span></div>
<div class="aui-done"><i class="live"></i> Approved by supervisor &middot; Recovery in progress</div>
</div>
</template>
<template id="tpl-xs">
<div class="xui" data-state="0">
<div class="xui-h"><span>Northstar Store &middot; Sign in</span><span class="seg"><i class="on">Desktop</i><i>Mobile</i></span></div>
<div class="xui-b">
<div class="xui-page"><i class="ln" style="width:58%"></i><i class="ln" style="width:36%"></i><div class="fld"><span class="lbl">Email</span><span class="inp">name@company.com</span></div><span class="cta">Sign in</span></div>
<div class="xui-f"><small>Finding &middot; Automated check</small><b>Form field needs a persistent label</b><span class="why">The placeholder disappears while typing, so the field loses its name.</span><div class="vars"><i>A</i><i class="pick">B</i><i>C</i></div><span class="ver">&#10003; Verified in demo</span></div>
</div>
<div class="xui-foot">Illustrative demo data</div>
</div>
</template>
