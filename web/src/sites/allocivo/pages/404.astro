---
// Allocivo: page not found (the same as before the move to Astro).
import ProductLayout from "../../../layouts/ProductLayout.astro";
import { SITES } from "../../index.mjs";
const S = SITES.allocivo;
---
<ProductLayout path="/404">
<div class={`prodhero ${S.short}`} data-dark><div class="wrap"><div class="phl"><h1>We couldn&#39;t find that page.</h1><div class="acts"><a class="btn pri" href="/">Go to the {S.name} overview</a><a class="btn out" href={S.cta.path}>{S.cta.label}</a></div></div></div></div>
</ProductLayout>
